# FoodVerse AI – Global Environment Configuration Template

# Server Settings
PORT=8000
ENVIRONMENT=development

# Google Gemini Vision & Multimodal AI
# Optional: The application runs with rich Demo sample data without a paid key!
# Set your Gemini API key below or configure directly in the UI Settings to activate live AI vision.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# MongoDB Database
# Optional: If MongoDB is not running locally, the system automatically runs in
# Resilient Local Storage mode (persisting to backend/data/store.json) with zero configuration!
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=foodverse_db

# Security & Authentication
JWT_SECRET=foodverse-secret-super-key-2026-multimodal-ai-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
