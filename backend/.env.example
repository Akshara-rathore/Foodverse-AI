# FoodVerse AI Environment Variables

# Server
PORT=8000
ENVIRONMENT=development

# Google Gemini AI (Optional for Live Mode; Demo Mode works without key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# MongoDB (Optional; falls back seamlessly to local JSON persistence if MongoDB is not running)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=foodverse_db

# Security & JWT
JWT_SECRET=foodverse-secret-super-key-2026-multimodal-ai-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
